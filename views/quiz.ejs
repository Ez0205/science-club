<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">科学小问答</h2>
          <div class="section-more">
            <span style="color: var(--text-light); font-size: 14px;">共 <%= questions.length %> 道题目</span>
          </div>
        </div>

        <% if (questions && questions.length > 0) { %>
          <form method="POST" action="/quiz/submit" class="quiz-container">
            <% questions.forEach(function(q, index) { %>
              <div class="quiz-question">
                <div class="quiz-question-title">
                  <span class="quiz-question-number"><%= index + 1 %></span>
                  <span><%= q.question %></span>
                  <% if (q.is_weekly) { %>
                    <span class="tag" style="margin-left: auto; align-self: flex-start;">本周题目</span>
                  <% } %>
                </div>

                <% if (q.type === 'choice') { %>
                  <div class="quiz-options">
                    <% let options = []; %>
                    <% if (q.options) { %>
                      <% try { options = JSON.parse(q.options); } catch(e) { options = []; } %>
                    <% } %>
                    <% const letters = ['A', 'B', 'C', 'D', 'E', 'F']; %>
                    <% options.forEach(function(opt, optIndex) { %>
                      <label class="quiz-option">
                        <input type="radio" name="q_<%= q.id %>" value="<%= opt %>" required>
                        <span><%= letters[optIndex] %>. <%= opt %></span>
                      </label>
                    <% }) %>
                  </div>
                <% } else if (q.type === 'truefalse') { %>
                  <div class="quiz-options">
                    <label class="quiz-option">
                      <input type="radio" name="q_<%= q.id %>" value="true" required>
                      <span>✓ 正确</span>
                    </label>
                    <label class="quiz-option">
                      <input type="radio" name="q_<%= q.id %>" value="false" required>
                      <span>✗ 错误</span>
                    </label>
                  </div>
                <% } %>
              </div>
            <% }) %>

            <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border);">
              <button type="submit" class="btn btn-primary btn-lg">提交答案</button>
            </div>
          </form>
        <% } else { %>
          <div class="quiz-container" style="text-align: center; padding: 60px 40px;">
            <div style="font-size: 64px; margin-bottom: 20px;">🧠</div>
            <p style="font-size: 16px; color: var(--text-light);">暂无题目</p>
          </div>
        <% } %>
      </div>
    </section>

<%- include('partials/footer') %>
