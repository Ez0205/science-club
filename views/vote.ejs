<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">在线投票</h2>
        </div>

        <% if (votes && votes.length > 0) { %>
          <% votes.forEach(function(vote, voteIndex) { %>
            <% const totalVotes = vote.candidates.reduce((sum, c) => sum + c.vote_count, 0); %>
            <div class="vote-card" id="vote-<%= vote.id %>">
              <div class="vote-header">
                <h2 class="vote-title">
                  🗳️ <%= vote.title %>
                  <span class="tag" style="margin-left: 10px; <%= vote.isActive ? 'background: #D1FAE5; color: #059669;' : 'background: #F3F4F6; color: #6B7280;' %>">
                    <%= vote.isActive ? '进行中' : '已结束' %>
                  </span>
                </h2>
                <div class="vote-info">
                  <span>📅 <%= vote.start_date %> 至 <%= vote.end_date %></span>
                  <span>总票数：<span id="total-count-<%= vote.id %>"><%= totalVotes %></span></span>
                </div>
                <% if (vote.description) { %>
                  <p style="margin-top: 10px; color: var(--text-light); font-size: 14px;"><%= vote.description %></p>
                <% } %>
              </div>

              <div class="vote-candidates" id="candidates-<%= vote.id %>">
                <% vote.candidates.forEach(function(candidate) { %>
                  <div class="vote-candidate" data-vote-id="<%= vote.id %>" data-candidate-id="<%= candidate.id %>" onclick="selectCandidate(<%= vote.id %>, <%= candidate.id %>)">
                    <% if (candidate.cover_image) { %>
                      <img src="<%= candidate.cover_image %>" alt="<%= candidate.title %>" class="vote-candidate-image">
                    <% } else { %>
                      <img src="https://picsum.photos/200/120?random=<%= candidate.id + 600 %>" alt="<%= candidate.title %>" class="vote-candidate-image">
                    <% } %>
                    <div class="vote-candidate-name"><%= candidate.title %></div>
                    <div class="vote-candidate-author">👤 <%= candidate.author %></div>
                    <div class="vote-progress-bar">
                      <div class="vote-progress-fill" style="width: <%= totalVotes > 0 ? (candidate.vote_count / totalVotes * 100) : 0 %>%"></div>
                    </div>
                    <div class="vote-count"><%= candidate.vote_count %> 票</div>
                  </div>
                <% }) %>
              </div>

              <% if (vote.isActive) { %>
              <div style="margin-top: 25px; text-align: center;">
                <button class="btn btn-primary btn-lg" onclick="submitVote(<%= vote.id %>)">
                  投出我的一票
                </button>
                <p style="margin-top: 10px; font-size: 13px; color: var(--text-light);">
                  点击选择你支持的作品，然后点击投票按钮
                </p>
              </div>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="vote-card">
            <div class="vote-header">
              <h2 class="vote-title">🗳️ 在线投票</h2>
            </div>
            <p style="text-align: center; color: var(--text-light); padding: 40px 0;">暂无投票活动</p>
          </div>
        <% } %>
      </div>
    </section>

    <script>
      // 存储每个投票选中的候选ID
      const selectedCandidates = {};

      function selectCandidate(voteId, candidateId) {
        selectedCandidates[voteId] = candidateId;

        // 更新UI
        const candidates = document.querySelectorAll('#candidates-' + voteId + ' .vote-candidate');
        candidates.forEach(function(c) {
          if (parseInt(c.dataset.candidateId) === candidateId) {
            c.classList.add('selected');
          } else {
            c.classList.remove('selected');
          }
        });
      }

      function submitVote(voteId) {
        const candidateId = selectedCandidates[voteId];

        if (!candidateId) {
          alert('请先选择一个候选作品');
          return;
        }

        if (!confirm('确定要投票吗？投票后不可更改。')) {
          return;
        }

        fetch('/vote/' + voteId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'same-origin',
          body: JSON.stringify({ candidate_id: candidateId })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message || '投票成功！');
            // 更新票数显示
            if (data.candidates) {
              const totalVotes = data.candidates.reduce((sum, c) => sum + c.vote_count, 0);
              document.getElementById('total-count-' + voteId).textContent = totalVotes;

              const container = document.getElementById('candidates-' + voteId);
              data.candidates.forEach(function(c, index) {
                const candidateEl = container.querySelectorAll('.vote-candidate')[index];
                if (candidateEl) {
                  const progressFill = candidateEl.querySelector('.vote-progress-fill');
                  const voteCount = candidateEl.querySelector('.vote-count');
                  if (progressFill) {
                    progressFill.style.width = (totalVotes > 0 ? (c.vote_count / totalVotes * 100) : 0) + '%';
                  }
                  if (voteCount) {
                    voteCount.textContent = c.vote_count + ' 票';
                  }
                }
              });
            }
          } else {
            alert(data.message || '投票失败');
          }
        })
        .catch(err => {
          console.error(err);
          alert('投票失败，请稍后重试');
        });
      }
    </script>

<%- include('partials/footer') %>
