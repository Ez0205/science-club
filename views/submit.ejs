<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <div class="submit-form">
          <div class="section-header" style="margin-bottom: 30px;">
            <h2 class="section-title">📝 作品投稿</h2>
          </div>

          <!-- 成功提示 -->
          <% if (success) { %>
          <div class="success-alert">
            <span>✅</span>
            <span><%= success %></span>
          </div>
          <% } %>

          <!-- 错误提示 -->
          <% if (error) { %>
          <div class="error-alert">
            <span>❌</span>
            <span><%= error %></span>
          </div>
          <% } %>

          <form action="/submit" method="POST" enctype="multipart/form-data" id="submitForm">
            <!-- 标题 -->
            <div class="form-group">
              <label>作品标题<span class="required">*</span></label>
              <input type="text" name="title" placeholder="请输入作品标题" required maxlength="100">
            </div>

            <!-- 分类和作者 -->
            <div class="form-row">
              <div class="form-group">
                <label>实验分类<span class="required">*</span></label>
                <select name="category" required>
                  <option value="">请选择分类</option>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat %>"><%= cat %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label>作者姓名<span class="required">*</span></label>
                <input type="text" name="author" placeholder="请输入作者姓名" required maxlength="50">
              </div>
            </div>

            <!-- 班级 -->
            <div class="form-group">
              <label>班级</label>
              <input type="text" name="class" placeholder="例如：高一(3)班" maxlength="50">
            </div>

            <!-- 实验简介 -->
            <div class="form-group">
              <label>实验简介<span class="required">*</span></label>
              <textarea name="summary" placeholder="简要描述实验的目的和内容..." required maxlength="500"></textarea>
            </div>

            <!-- 封面图上传 -->
            <div class="form-group">
              <label>封面图<span class="required">*</span></label>
              <div class="file-upload-area" id="coverUploadArea" onclick="document.getElementById('coverImageInput').click()">
                <div class="file-upload-icon">🖼️</div>
                <div class="file-upload-text">
                  点击或拖拽图片到此处上传封面图<br>
                  <span>支持 JPG、PNG、GIF 格式，建议尺寸 800x600</span>
                </div>
                <input type="file" id="coverImageInput" name="cover_image" accept="image/*" style="display: none;" onchange="previewCoverImage(event)">
              </div>
              <div class="file-preview" id="coverPreview"></div>
            </div>

            <!-- 多图上传 -->
            <div class="form-group">
              <label>实验图片（最多10张）</label>
              <div class="file-upload-area" id="imagesUploadArea" onclick="document.getElementById('imagesInput').click()">
                <div class="file-upload-icon">📸</div>
                <div class="file-upload-text">
                  点击或拖拽图片到此处上传实验过程图片<br>
                  <span>支持 JPG、PNG、GIF 格式，最多上传10张</span>
                </div>
                <input type="file" id="imagesInput" name="images" accept="image/*" multiple style="display: none;" onchange="previewMultipleImages(event)">
              </div>
              <div class="file-preview" id="imagesPreview"></div>
            </div>

            <!-- 视频上传 -->
            <div class="form-group">
              <label>实验视频（可选）</label>
              <div class="file-upload-area" id="videoUploadArea" onclick="document.getElementById('videoInput').click()">
                <div class="file-upload-icon">🎬</div>
                <div class="file-upload-text">
                  点击或拖拽视频到此处上传实验视频<br>
                  <span>仅支持 MP4 格式，大小不限</span>
                </div>
                <input type="file" id="videoInput" name="video" accept="video/mp4" style="display: none;" onchange="previewVideo(event)">
              </div>
              <div id="videoPreview" style="margin-top: 15px;"></div>
            </div>

            <!-- 实验原理 -->
            <div class="form-group">
              <label>实验原理</label>
              <textarea name="principle" placeholder="描述实验背后的科学原理..." maxlength="1000"></textarea>
            </div>

            <!-- 实验反思 -->
            <div class="form-group">
              <label>实验反思</label>
              <textarea name="reflection" placeholder="分享实验过程中的收获和改进建议..." maxlength="1000"></textarea>
            </div>

            <!-- 提交按钮 -->
            <div style="text-align: center; margin-top: 30px;">
              <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                🚀 提交作品
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <script>
      // 封面图预览
      function previewCoverImage(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = document.getElementById('coverPreview');
          preview.innerHTML = `
            <div class="file-preview-item">
              <img src="${e.target.result}" alt="封面预览">
              <button type="button" class="remove-btn" onclick="removeCoverImage()">&times;</button>
            </div>
          `;
        };
        reader.readAsDataURL(file);
      }

      function removeCoverImage() {
        document.getElementById('coverImageInput').value = '';
        document.getElementById('coverPreview').innerHTML = '';
      }

      // 多图预览
      let selectedImages = [];

      function previewMultipleImages(event) {
        const files = Array.from(event.target.files);
        const preview = document.getElementById('imagesPreview');
        
        files.forEach((file, index) => {
          if (selectedImages.length >= 10) return;
          
          const reader = new FileReader();
          reader.onload = function(e) {
            selectedImages.push({ file, src: e.target.result });
            renderImagesPreview();
          };
          reader.readAsDataURL(file);
        });
      }

      function renderImagesPreview() {
        const preview = document.getElementById('imagesPreview');
        preview.innerHTML = selectedImages.map((img, index) => `
          <div class="file-preview-item">
            <img src="${img.src}" alt="图片${index + 1}">
            <button type="button" class="remove-btn" onclick="removeImage(${index})">&times;</button>
          </div>
        `).join('');
      }

      function removeImage(index) {
        selectedImages.splice(index, 1);
        
        // 重新设置 input 的 files
        const input = document.getElementById('imagesInput');
        const dt = new DataTransfer();
        selectedImages.forEach(img => dt.items.add(img.file));
        input.files = dt.files;
        
        renderImagesPreview();
      }

      // 视频预览
      function previewVideo(event) {
        const file = event.target.files[0];
        if (!file) return;
        
        const preview = document.getElementById('videoPreview');
        const url = URL.createObjectURL(file);
        preview.innerHTML = `
          <div style="position: relative; display: inline-block;">
            <video src="${url}" controls style="max-width: 400px; border-radius: 8px;"></video>
            <button type="button" class="remove-btn" onclick="removeVideo()" style="position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; border-radius: 50%; background: rgba(0,0,0,0.6); color: white; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px;">&times;</button>
          </div>
          <p style="margin-top: 10px; font-size: 13px; color: var(--text-light);">
            ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)
          </p>
        `;
      }

      function removeVideo() {
        document.getElementById('videoInput').value = '';
        document.getElementById('videoPreview').innerHTML = '';
      }

      // 拖拽上传
      ['coverUploadArea', 'imagesUploadArea', 'videoUploadArea'].forEach(id => {
        const area = document.getElementById(id);
        
        area.addEventListener('dragover', function(e) {
          e.preventDefault();
          area.classList.add('dragover');
        });
        
        area.addEventListener('dragleave', function(e) {
          e.preventDefault();
          area.classList.remove('dragover');
        });
        
        area.addEventListener('drop', function(e) {
          e.preventDefault();
          area.classList.remove('dragover');
          
          const inputId = id === 'coverUploadArea' ? 'coverImageInput' :
                         id === 'imagesUploadArea' ? 'imagesInput' : 'videoInput';
          const input = document.getElementById(inputId);
          input.files = e.dataTransfer.files;
          
          if (id === 'coverUploadArea') {
            previewCoverImage({ target: input });
          } else if (id === 'imagesUploadArea') {
            previewMultipleImages({ target: input });
          } else {
            previewVideo({ target: input });
          }
        });
      });

      // 表单提交验证
      document.getElementById('submitForm').addEventListener('submit', function(e) {
        const coverInput = document.getElementById('coverImageInput');
        if (!coverInput.files.length) {
          alert('请上传封面图');
          e.preventDefault();
          return;
        }
        
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ 提交中...';
      });
    </script>

<%- include('partials/footer') %>
