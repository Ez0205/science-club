<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= siteSettings.site_name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- 头部 -->
  <header class="site-header">
    <div class="header-top">
      <div class="container">
        <div class="header-content">
          <div class="logo">
            <div class="logo-icon">🔬</div>
            <div class="logo-text">
              <h1><%= siteSettings.site_name %></h1>
              <p><%= siteSettings.site_slogan %></p>
            </div>
          </div>
          <div class="header-actions">
            <% if (user) { %>
              <span style="font-size:14px;">👋 <%= user.real_name || user.username %></span>
              <% if (user.role === 'admin') { %>
                <a href="/admin" class="btn btn-sm">管理后台</a>
              <% } %>
              <% if (user.role === 'teacher' || user.role === 'admin') { %>
                <a href="/submit" class="btn btn-sm">📝 上传作品</a>
              <% } %>
              <a href="/logout" class="btn btn-sm">退出</a>
            <% } else { %>
              <a href="/login" class="btn btn-sm">登录</a>
              <a href="/register" class="btn btn-sm">注册</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- 导航栏 -->
    <nav class="main-nav">
      <div class="container">
        <ul class="nav-list">
          <% navItems.forEach(function(item) { %>
            <li>
              <a href="<%= item.path %>" class="<%= activeNav === item.path ? 'active' : '' %>">
                <%= item.name %>
              </a>
            </li>
          <% }) %>
        </ul>
      </div>
    </nav>
    
    <!-- 公告滚动栏 -->
    <% if (announcements && announcements.length > 0) { %>
      <div class="announcement-bar">
        <div class="container">
          <div class="announcement-content">
            <% announcements.forEach(function(ann, index) { %>
              <span class="announcement-item">
                <span class="announcement-icon">公告</span>
                <span><%= ann.content %></span>
              </span>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>
  </header>
  
  <!-- 主内容 -->
  <main>
