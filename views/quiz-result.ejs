<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <!-- 得分展示 -->
        <div class="quiz-result-header">
          <div class="quiz-score"><%= score %> / <%= total %></div>
          <div class="quiz-score-label">
            <% const percentage = total > 0 ? Math.round(score / total * 100) : 0; %>
            <% if (percentage >= 80) { %>
              🎉 太棒了！你是科学小达人！
            <% } else if (percentage >= 60) { %>
              👍 不错哦，继续加油！
            <% } else { %>
              💪 继续努力，下次会更好！
            <% } %>
          </div>
          <div style="margin-top: 15px; font-size: 14px; opacity: 0.9;">
            正确率：<%= percentage %>%
          </div>
        </div>

        <!-- 每题详情 -->
        <div class="quiz-container">
          <% results.forEach(function(result, index) { %>
            <div class="quiz-question">
              <div class="quiz-question-title">
                <span class="quiz-question-number" style="background: <%= result.isCorrect ? 'var(--secondary)' : 'var(--danger)' %>;">
                  <%= result.isCorrect ? '✓' : '✗' %>
                </span>
                <span><%= result.question %></span>
              </div>

              <% if (result.type === 'choice') { %>
                <div class="quiz-options">
                  <% const letters = ['A', 'B', 'C', 'D', 'E', 'F']; %>
                  <% result.options.forEach(function(opt, optIndex) { %>
                    <% let optionClass = 'quiz-option'; %>
                    <% if (opt === result.correctAnswer) optionClass += ' correct'; %>
                    <% if (opt === result.userAnswer && !result.isCorrect) optionClass += ' incorrect'; %>
                    <label class="<%= optionClass %>">
                      <input type="radio" disabled <%= opt === result.userAnswer ? 'checked' : '' %>>
                      <span>
                        <%= letters[optIndex] %>. <%= opt %>
                        <% if (opt === result.correctAnswer) { %> <span style="color: var(--secondary); font-weight: 600;">（正确答案）</span><% } %>
                        <% if (opt === result.userAnswer && !result.isCorrect) { %> <span style="color: var(--danger); font-weight: 600;">（你的选择）</span><% } %>
                      </span>
                    </label>
                  <% }) %>
                </div>
              <% } else if (result.type === 'truefalse') { %>
                <div class="quiz-options">
                  <% ['true', 'false'].forEach(function(val) { %>
                    <% let optionClass = 'quiz-option'; %>
                    <% if (val === result.correctAnswer) optionClass += ' correct'; %>
                    <% if (val === result.userAnswer && !result.isCorrect) optionClass += ' incorrect'; %>
                    <label class="<%= optionClass %>">
                      <input type="radio" disabled <%= val === result.userAnswer ? 'checked' : '' %>>
                      <span>
                        <%= val === 'true' ? '✓ 正确' : '✗ 错误' %>
                        <% if (val === result.correctAnswer) { %> <span style="color: var(--secondary); font-weight: 600;">（正确答案）</span><% } %>
                        <% if (val === result.userAnswer && !result.isCorrect) { %> <span style="color: var(--danger); font-weight: 600;">（你的选择）</span><% } %>
                      </span>
                    </label>
                  <% }) %>
                </div>
              <% } %>

              <% if (result.explanation) { %>
                <div class="quiz-explanation">
                  <strong>💡 解析：</strong><%= result.explanation %>
                </div>
              <% } %>
            </div>
          <% }) %>

          <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border);">
            <a href="/quiz" class="btn btn-primary">再答一次</a>
            <a href="/" class="btn btn-outline" style="margin-left: 10px;">返回首页</a>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
