<%- include('partials/header') %>

    <section class="section" style="min-height: calc(100vh - 300px); display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin: 0; padding: 40px 20px;">
      <div class="container" style="max-width: 420px;">
        <div class="auth-card" style="box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
          <div class="auth-header">
            <div class="auth-logo" style="background: linear-gradient(135deg, #667eea, #764ba2);">⚙️</div>
            <h2 class="auth-title">管理员登录</h2>
            <p class="auth-subtitle">请使用管理员账号登录</p>
          </div>

          <% if (error) { %>
            <div class="auth-error">
              <%= error %>
            </div>
          <% } %>

          <form method="POST" action="/admin-login">
            <input type="hidden" name="redirect" value="<%= redirect %>">

            <div class="form-group">
              <label>管理员账号</label>
              <input type="text" name="username" placeholder="请输入管理员账号" required>
            </div>

            <div class="form-group">
              <label>密码</label>
              <input type="password" name="password" placeholder="请输入密码" required>
            </div>

            <button type="submit" class="btn btn-lg" style="width: 100%; margin-top: 10px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
              登录管理后台
            </button>
          </form>

          <div class="auth-footer">
            <a href="/">← 返回首页</a>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
