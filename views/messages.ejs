<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">留言板</h2>
          <div class="section-more">
            <span style="color: var(--text-light); font-size: 14px;">共 <%= messages.length %> 条留言</span>
          </div>
        </div>

        <div class="message-board">
          <!-- 成功提示 -->
          <% if (success && success == '1') { %>
            <div class="success-alert">
              <span>✅</span>
              <span>留言提交成功！感谢您的参与。</span>
            </div>
          <% } %>

          <!-- 留言表单 -->
          <div class="message-form">
            <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 15px;">💬 发表留言</h3>
            <form method="POST" action="/messages">
              <div class="form-group">
                <label>你的姓名 <span class="required">*</span></label>
                <input type="text" name="name" placeholder="请输入你的姓名" maxlength="50" required>
              </div>
              <div class="form-group">
                <label>留言内容 <span class="required">*</span></label>
                <textarea name="content" placeholder="写下你想说的话..." maxlength="500" rows="4" required></textarea>
              </div>
              <div style="text-align: right;">
                <button type="submit" class="btn btn-primary">提交留言</button>
              </div>
            </form>
          </div>

          <!-- 留言列表 -->
          <div style="margin-top: 30px;">
            <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 20px;">📝 全部留言</h3>

            <% if (messages && messages.length > 0) { %>
              <% messages.forEach(function(msg) { %>
                <div class="message-item">
                  <div class="message-header">
                    <span class="message-name"><%= msg.name %></span>
                    <span class="message-time">
                      <%= msg.created_at ? new Date(msg.created_at).toLocaleString('zh-CN') : '' %>
                    </span>
                  </div>
                  <div class="message-content"><%= msg.content %></div>

                  <% if (msg.reply) { %>
                    <div class="message-reply">
                      <div class="message-reply-label">👨‍🏫 老师回复</div>
                      <div class="message-reply-content"><%= msg.reply %></div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            <% } else { %>
              <p style="text-align: center; color: var(--text-light); padding: 30px 0;">
                暂无留言，快来抢沙发吧！
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
