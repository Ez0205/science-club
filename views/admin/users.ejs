<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">用户列表</div>
          <div style="font-size:13px;color:#6B7280;">共 <%= users.length %> 位用户</div>
        </div>
        <div class="admin-card-body" style="padding:0;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>用户名</th>
                <th>姓名</th>
                <th>角色</th>
                <th>邮箱</th>
                <th>上传权限</th>
                <th>注册时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><%= u.real_name || '-' %></td>
                <td>
                  <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:inline;" onsubmit="return confirm('确定修改该用户角色吗？')">
                    <select name="role" onchange="if(this.value !== '<%= u.role %>') this.form.submit();" style="font-size:12px;padding:2px 8px;border-radius:4px;border:1px solid #D1D5DB;">
                      <option value="parent" <%= u.role === 'parent' ? 'selected' : '' %>>家长</option>
                      <option value="teacher" <%= u.role === 'teacher' ? 'selected' : '' %>>老师</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>管理员</option>
                    </select>
                  </form>
                </td>
                <td style="font-size:12px;color:#6B7280;"><%= u.email || '-' %></td>
                <td>
                  <span class="status-badge <%= u.upload_enabled ? 'status-published' : 'status-rejected' %>">
                    <%= u.upload_enabled ? '已开启' : '已关闭' %>
                  </span>
                </td>
                <td style="font-size:12px;color:#6B7280;"><%= u.created_at %></td>
                <td>
                  <div class="actions">
                    <form method="POST" action="/admin/users/<%= u.id %>/toggle-upload" style="display:inline;">
                      <button type="submit" class="action-btn" style="background:#FEF3C7;color:#92400E;">
                        <%= u.upload_enabled ? '关闭上传' : '开启上传' %>
                      </button>
                    </form>
                    <form method="POST" action="/admin/users/<%= u.id %>/reset-password" style="display:inline;" onsubmit="return confirmResetPassword(this, '<%= u.username %>')">
                      <button type="submit" class="action-btn action-btn-edit">重置密码</button>
                    </form>
                    <% if (u.id !== user.id) { %>
                    <form method="POST" action="/admin/users/<%= u.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该用户吗？')">
                      <button type="submit" class="action-btn action-btn-delete">删除</button>
                    </form>
                    <% } %>
                  </div>
                </td>
              </tr>
              <% }); %>
              <% if (users.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align:center;color:#9CA3AF;padding:40px;">暂无用户</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 权限说明 -->
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">🔐 权限说明</div>
        </div>
        <div class="admin-card-body">
          <table class="admin-table">
            <thead>
              <tr>
                <th>角色</th>
                <th>浏览成果</th>
                <th>上传作品</th>
                <th>编辑公共板块</th>
                <th>审核作品</th>
                <th>管理用户</th>
                <th>后台管理</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>管理员</strong></td>
                <td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td><td>✅</td>
              </tr>
              <tr>
                <td><strong>老师</strong></td>
                <td>✅</td><td>✅</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td>
              </tr>
              <tr>
                <td><strong>家长</strong></td>
                <td>✅</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td>
              </tr>
            </tbody>
          </table>
          <p style="margin-top:15px;font-size:13px;color:#6B7280;">提示：可直接修改用户角色下拉框来分配权限，上传权限可通过"开启/关闭上传"按钮单独控制。</p>
        </div>
      </div>

      <!-- 新增用户表单 -->
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">新增用户</div>
        </div>
        <div class="admin-card-body">
          <form method="POST" action="/admin/users/new">
            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>用户名</label>
                <input type="text" name="username" placeholder="登录用户名" required>
              </div>
              <div class="admin-form-group">
                <label>密码</label>
                <input type="password" name="password" placeholder="初始密码" required>
              </div>
            </div>
            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>真实姓名</label>
                <input type="text" name="real_name" placeholder="真实姓名">
              </div>
              <div class="admin-form-group">
                <label>角色</label>
                <select name="role" required>
                  <option value="parent">家长</option>
                  <option value="teacher">老师</option>
                  <option value="admin">管理员</option>
                </select>
              </div>
            </div>
            <div class="admin-form-group">
              <label>邮箱</label>
              <input type="email" name="email" placeholder="邮箱地址">
            </div>
            <button type="submit" style="padding:10px 24px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:14px;">创建用户</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function confirmResetPassword(form, username) {
  const pwd = prompt('请输入新密码（留空则默认为 123456）：', '123456');
  if (pwd === null) return false;
  const input = document.createElement('input');
  input.type = 'hidden';
  input.name = 'password';
  input.value = pwd || '123456';
  form.appendChild(input);
  return true;
}
</script>
</body>
</html>
