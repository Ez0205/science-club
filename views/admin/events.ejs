<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-tabs">
          <div class="admin-tab active" onclick="switchTab('events')">📅 活动日程</div>
          <div class="admin-tab" onclick="switchTab('honors')">🏆 荣誉墙</div>
          <div class="admin-tab" onclick="switchTab('albums')">📷 相册管理</div>
        </div>

        <div class="admin-card-body">
          <!-- 活动日程 Tab -->
          <div id="tab-events" class="tab-content">
            <div style="margin-bottom:20px;">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>标题</th>
                    <th>日期</th>
                    <th>地点</th>
                    <th>类型</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% events.forEach(function(event) { %>
                  <tr>
                    <td><%= event.id %></td>
                    <td>
                      <div style="display:flex;align-items:center;gap:10px;">
                        <% if (event.image_url) { %>
                          <img src="<%= event.image_url %>" style="width:40px;height:40px;object-fit:cover;border-radius:4px;">
                        <% } %>
                        <span><%= event.title %></span>
                      </div>
                    </td>
                    <td><%= event.event_date %></td>
                    <td><%= event.location || '-' %></td>
                    <td>
                      <span class="status-badge <%= event.is_past ? 'status-rejected' : 'status-published' %>">
                        <%= event.is_past ? '往期活动' : '即将到来' %>
                      </span>
                    </td>
                    <td>
                      <form method="POST" action="/admin/events/<%= event.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该活动吗？')">
                        <button type="submit" class="action-btn action-btn-delete">删除</button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                  <% if (events.length === 0) { %>
                  <tr>
                    <td colspan="6" style="text-align:center;color:#9CA3AF;padding:20px;">暂无活动</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div style="border-top:1px solid #E5E7EB;padding-top:20px;">
              <h4 style="margin:0 0 15px;font-size:14px;color:#374151;">添加活动</h4>
              <form method="POST" action="/admin/events/new" enctype="multipart/form-data">
                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label>活动标题</label>
                    <input type="text" name="title" placeholder="活动标题" required>
                  </div>
                  <div class="admin-form-group">
                    <label>活动日期</label>
                    <input type="date" name="event_date" required>
                  </div>
                </div>
                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label>活动地点</label>
                    <input type="text" name="location" placeholder="活动地点">
                  </div>
                  <div class="admin-form-group">
                    <label>活动图片</label>
                    <input type="file" name="image" accept="image/*">
                  </div>
                </div>
                <div class="admin-form-group">
                  <label>活动描述</label>
                  <textarea name="description" rows="3" placeholder="活动描述"></textarea>
                </div>
                <div class="admin-form-group">
                  <label style="display:flex;align-items:center;gap:8px;">
                    <input type="checkbox" name="is_past" value="1">
                    <span style="margin:0;font-size:13px;">标记为往期活动</span>
                  </label>
                </div>
                <button type="submit" style="padding:8px 20px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:13px;">添加活动</button>
              </form>
            </div>
          </div>

          <!-- 荣誉墙 Tab -->
          <div id="tab-honors" class="tab-content" style="display:none;">
            <div style="margin-bottom:20px;">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>荣誉标题</th>
                    <th>获奖日期</th>
                    <th>证书</th>
                    <th>排序</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% honors.forEach(function(honor) { %>
                  <tr>
                    <td><%= honor.id %></td>
                    <td>
                      <div style="font-weight:500;"><%= honor.title %></div>
                      <% if (honor.description) { %>
                        <div style="font-size:12px;color:#6B7280;margin-top:2px;"><%= honor.description %></div>
                      <% } %>
                    </td>
                    <td><%= honor.award_date %></td>
                    <td>
                      <% if (honor.certificate_image) { %>
                        <img src="<%= honor.certificate_image %>" style="width:60px;height:40px;object-fit:cover;border-radius:4px;">
                      <% } else { %>
                        <span style="color:#9CA3AF;font-size:12px;">无</span>
                      <% } %>
                    </td>
                    <td><%= honor.sort_order %></td>
                    <td>
                      <form method="POST" action="/admin/honors/<%= honor.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该荣誉吗？')">
                        <button type="submit" class="action-btn action-btn-delete">删除</button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                  <% if (honors.length === 0) { %>
                  <tr>
                    <td colspan="6" style="text-align:center;color:#9CA3AF;padding:20px;">暂无荣誉</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div style="border-top:1px solid #E5E7EB;padding-top:20px;">
              <h4 style="margin:0 0 15px;font-size:14px;color:#374151;">添加荣誉</h4>
              <form method="POST" action="/admin/honors/new" enctype="multipart/form-data">
                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label>荣誉标题</label>
                    <input type="text" name="title" placeholder="荣誉标题" required>
                  </div>
                  <div class="admin-form-group">
                    <label>获奖日期</label>
                    <input type="date" name="award_date">
                  </div>
                </div>
                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label>证书图片</label>
                    <input type="file" name="certificate" accept="image/*">
                  </div>
                  <div class="admin-form-group">
                    <label>排序</label>
                    <input type="number" name="sort_order" value="0">
                  </div>
                </div>
                <div class="admin-form-group">
                  <label>荣誉描述</label>
                  <textarea name="description" rows="3" placeholder="荣誉描述"></textarea>
                </div>
                <button type="submit" style="padding:8px 20px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:13px;">添加荣誉</button>
              </form>
            </div>
          </div>

          <!-- 相册管理 Tab -->
          <div id="tab-albums" class="tab-content" style="display:none;">
            <div style="margin-bottom:20px;">
              <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));gap:15px;">
                <% albums.forEach(function(album) { %>
                <div style="border:1px solid #E5E7EB;border-radius:10px;overflow:hidden;">
                  <div style="aspect-ratio:4/3;background:#F3F4F6;display:flex;align-items:center;justify-content:center;">
                    <% if (album.cover_image) { %>
                      <img src="<%= album.cover_image %>" style="width:100%;height:100%;object-fit:cover;">
                    <% } else { %>
                      <span style="color:#9CA3AF;font-size:40px;">📷</span>
                    <% } %>
                  </div>
                  <div style="padding:10px;">
                    <div style="font-weight:500;font-size:14px;margin-bottom:4px;"><%= album.title %></div>
                    <% if (album.description) { %>
                      <div style="font-size:12px;color:#6B7280;margin-bottom:8px;"><%= album.description %></div>
                    <% } %>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                      <button type="button" class="action-btn action-btn-edit" onclick="openUploadModal(<%= album.id %>)">上传图片</button>
                      <form method="POST" action="/admin/albums/<%= album.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该相册吗？')">
                        <button type="submit" class="action-btn action-btn-delete">删除</button>
                      </form>
                    </div>
                  </div>
                </div>
                <% }); %>
                <% if (albums.length === 0) { %>
                <div style="grid-column:1/-1;text-align:center;color:#9CA3AF;padding:40px;">暂无相册</div>
                <% } %>
              </div>
            </div>

            <div style="border-top:1px solid #E5E7EB;padding-top:20px;">
              <h4 style="margin:0 0 15px;font-size:14px;color:#374151;">创建相册</h4>
              <form method="POST" action="/admin/albums/new" enctype="multipart/form-data">
                <div class="admin-form-row">
                  <div class="admin-form-group">
                    <label>相册名称</label>
                    <input type="text" name="title" placeholder="相册名称" required>
                  </div>
                  <div class="admin-form-group">
                    <label>封面图片</label>
                    <input type="file" name="cover" accept="image/*">
                  </div>
                </div>
                <div class="admin-form-group">
                  <label>相册描述</label>
                  <textarea name="description" rows="2" placeholder="相册描述（可选）"></textarea>
                </div>
                <button type="submit" style="padding:8px 20px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:13px;">创建相册</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 上传图片模态框 -->
<div class="admin-modal" id="uploadModal">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <div class="admin-modal-title">上传图片到相册</div>
      <button class="admin-modal-close" onclick="closeUploadModal()">&times;</button>
    </div>
    <form method="POST" id="uploadForm" enctype="multipart/form-data">
      <div class="admin-form-group">
        <label>选择图片（最多20张）</label>
        <input type="file" name="photos" accept="image/*" multiple required>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button type="button" onclick="closeUploadModal()" style="padding:8px 16px;background:#E5E7EB;color:#374151;border:none;border-radius:6px;cursor:pointer;">取消</button>
        <button type="submit" style="padding:8px 16px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;">上传</button>
      </div>
    </form>
  </div>
</div>

<script>
function switchTab(tab) {
  document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
  document.querySelectorAll('.admin-tab').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + tab).style.display = 'block';
  event.target.classList.add('active');
}

function openUploadModal(albumId) {
  document.getElementById('uploadForm').action = '/admin/albums/' + albumId + '/photos';
  document.getElementById('uploadModal').classList.add('active');
}

function closeUploadModal() {
  document.getElementById('uploadModal').classList.remove('active');
}
</script>
</body>
</html>
