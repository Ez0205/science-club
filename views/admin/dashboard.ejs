<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <!-- 统计卡片 -->
      <div class="admin-stats-grid">
        <div class="admin-stat-card">
          <div class="label">总作品数</div>
          <div class="value"><%= stats.totalWorks %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">已发布</div>
          <div class="value" style="color:#10B981;"><%= stats.publishedWorks %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">待审核</div>
          <div class="value" style="color:#F59E0B;"><%= stats.pendingWorks %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">总用户</div>
          <div class="value"><%= stats.totalUsers %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">老师数</div>
          <div class="value" style="color:#4F46E5;"><%= stats.teacherUsers %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">家长数</div>
          <div class="value" style="color:#8B5CF6;"><%= stats.parentUsers %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">总评论</div>
          <div class="value"><%= stats.totalComments %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">总点赞</div>
          <div class="value" style="color:#EF4444;"><%= stats.totalLikes %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">总浏览</div>
          <div class="value" style="color:#06B6D4;"><%= stats.totalViews %></div>
        </div>
        <div class="admin-stat-card">
          <div class="label">总留言</div>
          <div class="value"><%= stats.totalMessages %></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
        <!-- 最新作品 -->
        <div class="admin-card">
          <div class="admin-card-header">
            <div class="admin-card-title">最新作品</div>
            <a href="/admin/works" style="color:#4F46E5;text-decoration:none;font-size:13px;">查看全部</a>
          </div>
          <div class="admin-card-body" style="padding:0;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>标题</th>
                  <th>分类</th>
                  <th>状态</th>
                  <th>上传者</th>
                </tr>
              </thead>
              <tbody>
                <% recentWorks.forEach(function(work) { %>
                <tr>
                  <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= work.title %></td>
                  <td><%= work.category %></td>
                  <td>
                    <span class="status-badge <%= work.status === 'published' ? 'status-published' : work.status === 'pending' ? 'status-pending' : 'status-rejected' %>">
                      <%= work.status === 'published' ? '已发布' : work.status === 'pending' ? '待审核' : '已驳回' %>
                    </span>
                  </td>
                  <td><%= work.uploader_name || '-' %></td>
                </tr>
                <% }); %>
                <% if (recentWorks.length === 0) { %>
                <tr>
                  <td colspan="4" style="text-align:center;color:#9CA3AF;padding:30px;">暂无作品</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 分类统计 -->
        <div class="admin-card">
          <div class="admin-card-header">
            <div class="admin-card-title">分类统计</div>
          </div>
          <div class="admin-card-body">
            <div class="chart-container">
              <% if (categoryStats.length > 0) { %>
                <% var maxCount = Math.max(...categoryStats.map(c => c.count)); %>
                <% categoryStats.forEach(function(cat) { %>
                  <div class="chart-bar">
                    <div class="chart-bar-value"><%= cat.count %></div>
                    <div class="chart-bar-fill" style="height:<%= (cat.count / maxCount) * 220 %>px;"></div>
                    <div class="chart-bar-label"><%= cat.category %></div>
                  </div>
                <% }); %>
              <% } else { %>
                <div style="margin:auto;color:#9CA3AF;">暂无数据</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- 最近操作日志 -->
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">最近操作日志</div>
          <a href="/admin/logs" style="color:#4F46E5;text-decoration:none;font-size:13px;">查看全部</a>
        </div>
        <div class="admin-card-body">
          <div class="log-list">
            <% recentLogs.forEach(function(log) { %>
            <div class="log-item">
              <div class="log-time"><%= log.created_at %></div>
              <div class="log-user"><%= log.username || '系统' %></div>
              <div class="log-action">
                <strong><%= log.action %></strong>
                <% if (log.target) { %> - <%= log.target %><% } %>
                <% if (log.detail) { %> <span style="color:#6B7280;">(<%= log.detail %>)</span><% } %>
              </div>
            </div>
            <% }); %>
            <% if (recentLogs.length === 0) { %>
            <div style="text-align:center;color:#9CA3AF;padding:20px;">暂无日志</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
