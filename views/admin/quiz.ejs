<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">题目列表</div>
          <a href="/admin/quiz/new" style="padding:8px 16px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;text-decoration:none;font-size:13px;">+ 新增题目</a>
        </div>
        <div class="admin-card-body" style="padding:0;">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>题目</th>
                <th>类型</th>
                <th>正确答案</th>
                <th>每周一题</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% questions.forEach(function(q) { %>
              <tr>
                <td><%= q.id %></td>
                <td style="max-width:400px;">
                  <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= q.question %></div>
                </td>
                <td>
                  <span class="status-badge" style="background:#EDE9FE;color:#5B21B6;">
                    <%= q.type === 'choice' ? '选择题' : '判断题' %>
                  </span>
                </td>
                <td style="font-weight:600;color:#065F46;"><%= q.correct_answer %></td>
                <td>
                  <% if (q.is_weekly) { %>
                    <span class="status-badge status-published">⭐ 每周一题</span>
                  <% } else { %>
                    <span style="color:#9CA3AF;font-size:12px;">否</span>
                  <% } %>
                </td>
                <td>
                  <div class="actions">
                    <form method="POST" action="/admin/quiz/<%= q.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该题目吗？')">
                      <button type="submit" class="action-btn action-btn-delete">删除</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
              <% if (questions.length === 0) { %>
              <tr>
                <td colspan="6" style="text-align:center;color:#9CA3AF;padding:40px;">暂无题目</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
