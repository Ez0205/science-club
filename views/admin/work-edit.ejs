<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">编辑作品 #<%= work.id %></div>
          <a href="/admin/works" style="color:#6B7280;text-decoration:none;font-size:13px;">← 返回列表</a>
        </div>
        <div class="admin-card-body">
          <form method="POST" action="/admin/works/<%= work.id %>/edit" enctype="multipart/form-data">
            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>作品标题</label>
                <input type="text" name="title" value="<%= work.title %>" required>
              </div>
              <div class="admin-form-group">
                <label>分类</label>
                <select name="category" required>
                  <% categories.forEach(function(cat) { %>
                    <option value="<%= cat %>" <%= work.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>作者</label>
                <input type="text" name="author" value="<%= work.author %>" required>
              </div>
              <div class="admin-form-group">
                <label>班级</label>
                <input type="text" name="class" value="<%= work.class %>">
              </div>
            </div>

            <div class="admin-form-group">
              <label>作品简介</label>
              <textarea name="summary" rows="3" required><%= work.summary %></textarea>
            </div>

            <div class="admin-form-group">
              <label>科学原理</label>
              <textarea name="principle" rows="4"><%= work.principle %></textarea>
            </div>

            <div class="admin-form-group">
              <label>反思与收获</label>
              <textarea name="reflection" rows="4"><%= work.reflection %></textarea>
            </div>

            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>状态</label>
                <select name="status">
                  <option value="pending" <%= work.status === 'pending' ? 'selected' : '' %>>待审核</option>
                  <option value="published" <%= work.status === 'published' ? 'selected' : '' %>>已发布</option>
                  <option value="rejected" <%= work.status === 'rejected' ? 'selected' : '' %>>已驳回</option>
                </select>
              </div>
              <div class="admin-form-group">
                <label>封面图</label>
                <input type="file" name="cover_image" accept="image/*">
                <% if (work.cover_image) { %>
                  <div style="margin-top:10px;">
                    <img src="<%= work.cover_image %>" style="width:120px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #E5E7EB;">
                    <div style="font-size:12px;color:#6B7280;margin-top:4px;">当前封面图，不更换则不上传</div>
                  </div>
                <% } %>
              </div>
            </div>

            <div class="admin-form-group">
              <label>作品图片（可追加多张）</label>
              <input type="file" name="images" accept="image/*" multiple>
              <% if (images && images.length > 0) { %>
                <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:10px;">
                  <% images.forEach(function(img, index) { %>
                    <div style="position:relative;">
                      <img src="<%= img %>" style="width:100px;height:100px;object-fit:cover;border-radius:6px;border:1px solid #E5E7EB;">
                      <div style="font-size:11px;color:#6B7280;text-align:center;margin-top:2px;"><%= index + 1 %></div>
                    </div>
                  <% }); %>
                </div>
                <div style="font-size:12px;color:#6B7280;margin-top:6px;">现有 <%= images.length %> 张图片，上传新图片将追加</div>
              <% } %>
            </div>

            <div class="admin-form-group">
              <label>视频文件</label>
              <input type="file" name="video" accept="video/*">
              <% if (work.video_url) { %>
                <div style="margin-top:10px;font-size:13px;color:#10B981;">
                  🎬 已有视频，不更换则不上传
                </div>
              <% } %>
            </div>

            <div style="display:flex;gap:12px;margin-top:25px;">
              <button type="submit" style="padding:10px 24px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:14px;">保存修改</button>
              <a href="/admin/works" style="padding:10px 24px;background:#E5E7EB;color:#374151;border:none;border-radius:6px;cursor:pointer;font-size:14px;text-decoration:none;">取消</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
