<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">新增题目</div>
          <a href="/admin/quiz" style="color:#6B7280;text-decoration:none;font-size:13px;">← 返回列表</a>
        </div>
        <div class="admin-card-body">
          <form method="POST" action="/admin/quiz/new" id="quizForm">
            <div class="admin-form-group">
              <label>题目内容</label>
              <textarea name="question" rows="3" placeholder="请输入题目内容" required></textarea>
            </div>

            <div class="admin-form-row">
              <div class="admin-form-group">
                <label>题目类型</label>
                <select name="type" id="questionType" onchange="toggleOptions()" required>
                  <option value="choice">选择题</option>
                  <option value="judge">判断题</option>
                </select>
              </div>
              <div class="admin-form-group">
                <label>是否每周一题</label>
                <div style="display:flex;align-items:center;gap:10px;padding:8px 0;">
                  <input type="checkbox" name="is_weekly" id="isWeekly" value="1">
                  <label for="isWeekly" style="font-size:13px;color:#374151;margin:0;">设为每周一题（将取消其他题目的每周一题标记）</label>
                </div>
              </div>
            </div>

            <!-- 选择题选项 -->
            <div id="choiceOptions">
              <div class="admin-form-group">
                <label>选项列表</label>
                <div id="optionsList">
                  <div style="display:flex;gap:8px;margin-bottom:8px;">
                    <input type="text" name="options[]" placeholder="选项 A" style="flex:1;">
                  </div>
                  <div style="display:flex;gap:8px;margin-bottom:8px;">
                    <input type="text" name="options[]" placeholder="选项 B" style="flex:1;">
                  </div>
                </div>
                <button type="button" onclick="addOption()" style="padding:6px 12px;background:#F3F4F6;color:#374151;border:1px solid #D1D5DB;border-radius:6px;cursor:pointer;font-size:12px;">+ 添加选项</button>
              </div>

              <div class="admin-form-group">
                <label>正确答案（输入选项字母，如 A）</label>
                <input type="text" name="correct_answer" placeholder="A/B/C/D" style="width:120px;">
              </div>
            </div>

            <!-- 判断题答案 -->
            <div id="judgeOptions" style="display:none;">
              <div class="admin-form-group">
                <label>正确答案</label>
                <select name="correct_answer_judge" style="width:120px;">
                  <option value="正确">正确</option>
                  <option value="错误">错误</option>
                </select>
              </div>
            </div>

            <div class="admin-form-group">
              <label>答案解析</label>
              <textarea name="explanation" rows="3" placeholder="请输入答案解析（可选）"></textarea>
            </div>

            <div style="display:flex;gap:12px;margin-top:25px;">
              <button type="submit" style="padding:10px 24px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;font-size:14px;">保存题目</button>
              <a href="/admin/quiz" style="padding:10px 24px;background:#E5E7EB;color:#374151;border:none;border-radius:6px;cursor:pointer;font-size:14px;text-decoration:none;">取消</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function toggleOptions() {
  const type = document.getElementById('questionType').value;
  document.getElementById('choiceOptions').style.display = type === 'choice' ? 'block' : 'none';
  document.getElementById('judgeOptions').style.display = type === 'judge' ? 'block' : 'none';
}

function addOption() {
  const list = document.getElementById('optionsList');
  const count = list.children.length;
  const labels = ['A','B','C','D','E','F','G','H'];
  const div = document.createElement('div');
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px;';
  div.innerHTML = `
    <input type="text" name="options[]" placeholder="选项 ${labels[count] || count + 1}" style="flex:1;">
    <button type="button" onclick="this.parentElement.remove()" style="padding:0 10px;background:#FEE2E2;color:#991B1B;border:none;border-radius:6px;cursor:pointer;">删除</button>
  `;
  list.appendChild(div);
}

document.getElementById('quizForm').addEventListener('submit', function(e) {
  const type = document.getElementById('questionType').value;
  if (type === 'judge') {
    // 将判断题答案赋值到 correct_answer
    const judgeAnswer = document.querySelector('select[name="correct_answer_judge"]').value;
    const hiddenInput = document.createElement('input');
    hiddenInput.type = 'hidden';
    hiddenInput.name = 'correct_answer';
    hiddenInput.value = judgeAnswer;
    this.appendChild(hiddenInput);
  }
});
</script>
</body>
</html>
