<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> - 管理后台</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div class="admin-topbar-title"><%= title %></div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" style="color:#6B7280;text-decoration:none;">查看网站</a>
        <div class="admin-user-info">
          <div class="admin-avatar"><%= user.real_name ? user.real_name[0] : 'A' %></div>
          <span style="font-size:14px;"><%= user.real_name || user.username %></span>
        </div>
        <a href="/logout" style="color:#6B7280;text-decoration:none;font-size:14px;">退出</a>
      </div>
    </div>
    <div class="admin-content">
      <div class="admin-card">
        <div class="admin-card-header">
          <div class="admin-card-title">投票列表</div>
          <a href="/admin/votes/new" style="padding:8px 16px;background:#4F46E5;color:white;border:none;border-radius:6px;cursor:pointer;text-decoration:none;font-size:13px;">+ 新建投票</a>
        </div>
        <div class="admin-card-body">
          <div style="display:flex;flex-direction:column;gap:15px;">
            <% votes.forEach(function(vote) { %>
            <div style="border:1px solid #E5E7EB;border-radius:10px;padding:20px;">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                <div>
                  <h3 style="margin:0 0 6px;font-size:16px;color:#1F2937;"><%= vote.title %></h3>
                  <div style="font-size:12px;color:#6B7280;">
                    开始：<%= vote.start_date %> | 结束：<%= vote.end_date %>
                  </div>
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                  <span class="status-badge <%= vote.is_active ? 'status-published' : 'status-rejected' %>">
                    <%= vote.is_active ? '进行中' : '已关闭' %>
                  </span>
                  <% if (vote.is_active) { %>
                    <form method="POST" action="/admin/votes/<%= vote.id %>/close" style="display:inline;" onsubmit="return confirm('确定关闭该投票吗？')">
                      <button type="submit" class="action-btn action-btn-reject">关闭</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/votes/<%= vote.id %>/delete" style="display:inline;" onsubmit="return confirm('确定删除该投票吗？')">
                    <button type="submit" class="action-btn action-btn-delete">删除</button>
                  </form>
                </div>
              </div>
              <% if (vote.description) { %>
                <p style="margin:0 0 12px;font-size:13px;color:#4B5563;"><%= vote.description %></p>
              <% } %>
              <div style="background:#F9FAFB;border-radius:8px;padding:12px;">
                <div style="font-size:12px;color:#6B7280;margin-bottom:8px;">候选作品（<%= vote.candidates.length %> 个）</div>
                <div style="display:flex;flex-wrap:wrap;gap:8px;">
                  <% vote.candidates.forEach(function(c) { %>
                    <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:white;border:1px solid #E5E7EB;border-radius:20px;font-size:12px;">
                      <%= c.title %>
                      <span style="color:#4F46E5;font-weight:600;"><%= c.vote_count %>票</span>
                    </span>
                  <% }); %>
                  <% if (vote.candidates.length === 0) { %>
                    <span style="color:#9CA3AF;font-size:12px;">暂无候选作品</span>
                  <% } %>
                </div>
              </div>
            </div>
            <% }); %>
            <% if (votes.length === 0) { %>
            <div style="text-align:center;color:#9CA3AF;padding:40px;">暂无投票，点击右上角新建投票</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
