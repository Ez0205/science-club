<%- include('partials/header') %>

    <section class="section" style="min-height: calc(100vh - 300px); display: flex; align-items: center; justify-content: center;">
      <div class="container" style="max-width: 460px;">
        <div class="auth-card" style="box-shadow: var(--shadow-lg);">
          <div class="auth-header">
            <div class="auth-logo">🔬</div>
            <h2 class="auth-title">创建账号</h2>
            <p class="auth-subtitle">加入科学实验社团大家庭</p>
          </div>

          <% if (error) { %>
            <div class="auth-error">
              <%= error %>
            </div>
          <% } %>

          <form method="POST" action="/register">
            <div class="form-group">
              <label>用户名 <span class="required">*</span></label>
              <input type="text" name="username" placeholder="请设置用户名" required>
            </div>

            <div class="form-group">
              <label>密码 <span class="required">*</span></label>
              <input type="password" name="password" placeholder="请设置密码（至少6位）" required minlength="6">
            </div>

            <div class="form-group">
              <label>真实姓名 <span class="required">*</span></label>
              <input type="text" name="real_name" placeholder="请输入真实姓名" required>
            </div>

            <div class="form-group">
              <label>邮箱</label>
              <input type="email" name="email" placeholder="请输入邮箱（选填）">
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 10px;">
              注册
            </button>
          </form>

          <div class="auth-footer">
            已有账号？<a href="/login">立即登录</a>
          </div>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
