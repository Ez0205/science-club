<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <!-- 相册头部 -->
        <div class="album-detail-header">
          <h1 class="album-detail-title"><%= album.title %></h1>
          <p class="album-detail-desc"><%= album.description || '暂无描述' %></p>
          <p style="color: var(--text-light); font-size: 14px; margin-top: 10px;">
            📷 共 <%= photos.length %> 张照片
          </p>
        </div>

        <!-- 照片网格 -->
        <% if (photos && photos.length > 0) { %>
          <div class="photos-grid">
            <% photos.forEach(function(photo, index) { %>
              <div class="photo-item">
                <img src="<%= photo.image_url %>" alt="<%= photo.caption || '照片 ' + (index + 1) %>" class="zoomable" onclick="openImageModal('<%= photo.image_url %>')">
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 60px 0; color: var(--text-light);">
            <div style="font-size: 48px; margin-bottom: 15px;">🖼️</div>
            <p>该相册暂无照片</p>
          </div>
        <% } %>

        <div style="text-align: center; margin-top: 30px;">
          <a href="/albums" class="btn btn-outline">← 返回相册列表</a>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
