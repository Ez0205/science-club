<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <div style="text-align: center; padding: 80px 0;">
          <div style="font-size: 80px; margin-bottom: 20px;">⚠️</div>
          <h2 style="font-size: 28px; font-weight: 700; margin-bottom: 15px; color: var(--text);">
            <%= title || '出错了' %>
          </h2>
          <p style="font-size: 16px; color: var(--text-light); margin-bottom: 40px; max-width: 500px; margin-left: auto; margin-right: auto;">
            <%= message || '服务器遇到了一些问题，请稍后再试。' %>
          </p>
          <div style="display: flex; gap: 15px; justify-content: center;">
            <a href="/" class="btn btn-primary btn-lg">🏠 返回首页</a>
            <button onclick="history.back()" class="btn btn-outline btn-lg">← 返回上一页</button>
          </div>
          
          <% if (typeof error !== 'undefined' && error && error.stack) { %>
          <div style="margin-top: 40px; text-align: left; background: #F9FAFB; padding: 20px; border-radius: var(--radius-sm); max-width: 600px; margin-left: auto; margin-right: auto;">
            <details>
              <summary style="cursor: pointer; color: var(--text-light); font-size: 14px;">查看详细错误信息</summary>
              <pre style="margin-top: 15px; font-size: 13px; color: #6B7280; overflow-x: auto; white-space: pre-wrap; word-break: break-all;"><%= error.stack %></pre>
            </details>
          </div>
          <% } %>
        </div>
      </div>
    </section>

<%- include('partials/footer') %>
