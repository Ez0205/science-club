<%- include('partials/header') %>

    <!-- 轮播图 -->
    <% if (banners && banners.length > 0) { %>
    <section class="section" style="padding-bottom: 0;">
      <div class="container">
        <div class="hero-carousel" id="heroCarousel">
          <% banners.forEach(function(banner, index) { %>
            <div class="carousel-slide <%= index === 0 ? 'active' : '' %>">
              <img src="<%= banner.image_url %>" alt="<%= banner.title %>">
              <% if (banner.title || banner.subtitle) { %>
              <div class="carousel-overlay">
                <% if (banner.title) { %><h2><%= banner.title %></h2><% } %>
                <% if (banner.subtitle) { %><p><%= banner.subtitle %></p><% } %>
              </div>
              <% } %>
            </div>
          <% }) %>
          <div class="carousel-dots">
            <% banners.forEach(function(banner, index) { %>
              <span class="carousel-dot <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>"></span>
            <% }) %>
          </div>
        </div>
      </div>
    </section>
    <% } %>

    <!-- 数据统计卡片 -->
    <section class="section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon blue">🔬</div>
            <div class="stat-number"><%= stats.totalWorks %></div>
            <div class="stat-label">累计实验</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon green">👨‍🎓</div>
            <div class="stat-number"><%= stats.totalStudents %></div>
            <div class="stat-label">参与学生</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon yellow">🏆</div>
            <div class="stat-number"><%= stats.totalHonors %></div>
            <div class="stat-label">获奖作品</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon purple">👁️</div>
            <div class="stat-number"><%= stats.totalViews %></div>
            <div class="stat-label">总浏览量</div>
          </div>
        </div>

        <!-- 精选成果轮播区 -->
        <% if (featuredWorks && featuredWorks.length > 0) { %>
        <div class="section-header">
          <h2 class="section-title">精选成果</h2>
          <div class="section-more"><a href="/works">查看更多 →</a></div>
        </div>
        <div class="works-grid">
          <% featuredWorks.forEach(function(work) { %>
            <div class="work-card" onclick="location.href='/works/<%= work.id %>'">
              <div class="work-card-image">
                <% if (work.cover_image) { %>
                  <img src="<%= work.cover_image %>" alt="<%= work.title %>">
                <% } else { %>
                  <img src="https://picsum.photos/400/300?random=<%= work.id %>" alt="<%= work.title %>">
                <% } %>
                <div class="work-card-badge">
                  <span class="tag tag-<%= work.category %>"><%= work.category %></span>
                </div>
              </div>
              <div class="work-card-body">
                <h3 class="work-card-title"><%= work.title %></h3>
                <div class="work-card-meta">
                  <span class="work-card-author">👤 <%= work.author %></span>
                  <span class="work-card-stats">
                    <span>👍 <%= work.likes || 0 %></span>
                    <span>💬 <%= work.comment_count || 0 %></span>
                  </span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </section>

    <!-- 最新作品展示 -->
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">最新作品</h2>
          <div class="section-more"><a href="/works">查看更多 →</a></div>
        </div>
        <div class="works-grid">
          <% if (latestWorks && latestWorks.length > 0) { %>
            <% latestWorks.forEach(function(work) { %>
              <div class="work-card" onclick="location.href='/works/<%= work.id %>'">
                <div class="work-card-image">
                  <% if (work.cover_image) { %>
                    <img src="<%= work.cover_image %>" alt="<%= work.title %>">
                  <% } else { %>
                    <img src="https://picsum.photos/400/300?random=<%= work.id + 100 %>" alt="<%= work.title %>">
                  <% } %>
                  <div class="work-card-badge">
                    <span class="tag tag-<%= work.category %>"><%= work.category %></span>
                  </div>
                </div>
                <div class="work-card-body">
                  <h3 class="work-card-title"><%= work.title %></h3>
                  <div class="work-card-meta">
                    <span class="work-card-author">👤 <%= work.author %></span>
                    <span class="work-card-stats">
                      <span>👍 <%= work.likes || 0 %></span>
                      <span>💬 <%= work.comment_count || 0 %></span>
                    </span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: var(--text-light); padding: 40px 0;">暂无作品</p>
          <% } %>
        </div>
      </div>
    </section>

    <!-- 投票板块 + 本周科学问答 + 活动预告 -->
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
          <!-- 投票板块 -->
          <div>
            <% if (activeVote) { %>
            <div class="vote-card">
              <div class="vote-header">
                <h2 class="vote-title">🗳️ <%= activeVote.title %></h2>
                <div class="vote-info">
                  <span>📅 <%= activeVote.start_date %> 至 <%= activeVote.end_date %></span>
                  <span>总票数：<%= voteCandidates.reduce((sum, c) => sum + c.vote_count, 0) %></span>
                </div>
              </div>
              <div class="vote-candidates">
                <% voteCandidates.forEach(function(candidate) { %>
                  <div class="vote-candidate" data-id="<%= candidate.id %>">
                    <% if (candidate.cover_image) { %>
                      <img src="<%= candidate.cover_image %>" alt="<%= candidate.title %>" class="vote-candidate-image">
                    <% } else { %>
                      <img src="https://picsum.photos/200/120?random=<%= candidate.id + 200 %>" alt="<%= candidate.title %>" class="vote-candidate-image">
                    <% } %>
                    <div class="vote-candidate-name"><%= candidate.title %></div>
                    <div class="vote-candidate-author">👤 <%= candidate.author %></div>
                    <div class="vote-progress-bar">
                      <div class="vote-progress-fill" style="width: <%= voteCandidates.reduce((sum, c) => sum + c.vote_count, 0) > 0 ? (candidate.vote_count / voteCandidates.reduce((sum, c) => sum + c.vote_count, 0) * 100) : 0 %>%"></div>
                    </div>
                    <div class="vote-count"><%= candidate.vote_count %> 票</div>
                  </div>
                <% }) %>
              </div>
              <div style="margin-top: 20px; text-align: center;">
                <a href="/vote" class="btn btn-primary">参与投票</a>
              </div>
            </div>
            <% } else { %>
            <div class="vote-card">
              <div class="vote-header">
                <h2 class="vote-title">🗳️ 在线投票</h2>
              </div>
              <p style="text-align: center; color: var(--text-light); padding: 30px 0;">暂无进行中的投票活动</p>
              <div style="text-align: center;">
                <a href="/vote" class="btn btn-outline">查看全部投票</a>
              </div>
            </div>
            <% } %>

            <!-- 本周科学问答 -->
            <% if (weeklyQuiz) { %>
            <div class="quiz-container">
              <div class="section-header" style="margin-bottom: 20px;">
                <h2 class="section-title">🧠 本周科学问答</h2>
              </div>
              <div class="quiz-question">
                <div class="quiz-question-title">
                  <span class="quiz-question-number">Q</span>
                  <span><%= weeklyQuiz.question %></span>
                </div>
                <div class="quiz-options">
                  <% ['A', 'B', 'C', 'D'].forEach(function(letter, idx) { %>
                    <% let optionKey = 'option_' + letter.toLowerCase(); %>
                    <% if (weeklyQuiz[optionKey]) { %>
                      <label class="quiz-option">
                        <input type="radio" name="quiz-answer" value="<%= letter %>">
                        <span><%= letter %>. <%= weeklyQuiz[optionKey] %></span>
                      </label>
                    <% } %>
                  <% }) %>
                </div>
              </div>
              <div style="text-align: center; margin-top: 20px;">
                <a href="/quiz" class="btn btn-primary">提交答案</a>
              </div>
            </div>
            <% } %>
          </div>

          <!-- 活动预告 -->
          <div>
            <div class="card" style="padding: 30px;">
              <div class="section-header" style="margin-bottom: 20px;">
                <h2 class="section-title">📅 活动预告</h2>
              </div>
              <div class="timeline">
                <% if (events && events.length > 0) { %>
                  <% events.forEach(function(event) { %>
                    <div class="timeline-item">
                      <div class="timeline-date"><%= event.event_date %></div>
                      <div class="timeline-title"><%= event.title %></div>
                      <div class="timeline-desc"><%= event.description %></div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p style="color: var(--text-light);">暂无活动</p>
                <% } %>
              </div>
              <div style="text-align: center; margin-top: 20px;">
                <a href="/about" class="btn btn-outline btn-sm">查看更多活动</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      // 轮播图自动轮播
      (function() {
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.carousel-dot');
        let currentIndex = 0;
        const totalSlides = slides.length;
        
        if (totalSlides <= 1) return;
        
        function showSlide(index) {
          slides.forEach((slide, i) => {
            slide.classList.toggle('active', i === index);
          });
          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === index);
          });
          currentIndex = index;
        }
        
        function nextSlide() {
          const nextIndex = (currentIndex + 1) % totalSlides;
          showSlide(nextIndex);
        }
        
        // 自动轮播
        setInterval(nextSlide, 5000);
        
        // 点击圆点切换
        dots.forEach((dot, index) => {
          dot.addEventListener('click', function() {
            showSlide(index);
          });
        });
      })();
    </script>

<%- include('partials/footer') %>
