<%- include('partials/header') %>

    <section class="section">
      <div class="container">
        <!-- 搜索和筛选 -->
        <div class="filter-bar">
          <div class="search-box">
            <input type="text" id="searchInput" placeholder="搜索作品标题、作者、简介..." value="<%= keyword %>">
          </div>
          <div class="category-tabs">
            <button class="category-tab <%= !currentCategory ? 'active' : '' %>" onclick="filterByCategory('')">全部</button>
            <% categories.forEach(function(cat) { %>
              <button class="category-tab <%= currentCategory === cat ? 'active' : '' %>" onclick="filterByCategory('<%= cat %>')">
                <%= cat %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- 作品网格 -->
        <div class="works-grid">
          <% if (works && works.length > 0) { %>
            <% works.forEach(function(work) { %>
              <div class="work-card" onclick="location.href='/works/<%= work.id %>'">
                <div class="work-card-image">
                  <% if (work.cover_image) { %>
                    <img src="<%= work.cover_image %>" alt="<%= work.title %>">
                  <% } else { %>
                    <img src="https://picsum.photos/400/300?random=<%= work.id %>" alt="<%= work.title %>">
                  <% } %>
                  <div class="work-card-badge">
                    <span class="tag tag-<%= work.category %>"><%= work.category %></span>
                  </div>
                </div>
                <div class="work-card-body">
                  <h3 class="work-card-title"><%= work.title %></h3>
                  <div class="work-card-meta">
                    <span class="work-card-author">👤 <%= work.author %></span>
                    <span class="work-card-stats">
                      <span>👍 <%= work.likes || 0 %></span>
                      <span>💬 <%= work.comment_count || 0 %></span>
                    </span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="grid-column: 1/-1; text-align: center; padding: 60px 0; color: var(--text-light);">
              <div style="font-size: 64px; margin-bottom: 20px;">🔍</div>
              <p style="font-size: 16px;">暂无符合条件的作品</p>
              <p style="font-size: 14px; margin-top: 8px;">试试其他关键词或分类吧</p>
            </div>
          <% } %>
        </div>

        <!-- 分页 -->
        <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="?category=<%= currentCategory %>&keyword=<%= encodeURIComponent(keyword) %>&page=<%= currentPage - 1 %>">上一页</a>
          <% } else { %>
            <span class="disabled">上一页</span>
          <% } %>
          
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
              <% if (i === currentPage) { %>
                <span class="current"><%= i %></span>
              <% } else { %>
                <a href="?category=<%= currentCategory %>&keyword=<%= encodeURIComponent(keyword) %>&page=<%= i %>"><%= i %></a>
              <% } %>
            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
              <span>...</span>
            <% } %>
          <% } %>
          
          <% if (currentPage < totalPages) { %>
            <a href="?category=<%= currentCategory %>&keyword=<%= encodeURIComponent(keyword) %>&page=<%= currentPage + 1 %>">下一页</a>
          <% } else { %>
            <span class="disabled">下一页</span>
          <% } %>
        </div>
        <% } %>

        <% if (works && works.length > 0) { %>
        <p style="text-align: center; color: var(--text-light); font-size: 14px; margin-top: 15px;">
          共 <%= total %> 个作品，第 <%= currentPage %> / <%= totalPages %> 页
        </p>
        <% } %>
      </div>
    </section>

    <script>
      // 分类筛选
      function filterByCategory(category) {
        const keyword = document.getElementById('searchInput').value;
        let url = '/works?';
        if (category) url += 'category=' + encodeURIComponent(category) + '&';
        if (keyword) url += 'keyword=' + encodeURIComponent(keyword);
        window.location.href = url;
      }

      // 搜索框回车搜索
      document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          filterByCategory('<%= currentCategory %>');
        }
      });
    </script>

<%- include('partials/footer') %>
